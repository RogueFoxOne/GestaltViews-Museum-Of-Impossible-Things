{
  "//": "============================================================================",
  "// Museum of Impossible Things - VSCode Settings": "",
  "// Forest Green & Midnight Blue Theme": "",
  "// Optimized for Python, JavaScript/TypeScript, and AI/ML development": "",
  "// ========== THEME & APPEARANCE ==========": "",
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "window.titleBarStyle": "custom",
  "workbench.colorCustomizations": {
    "// Title Bar": "",
    "titleBar.activeBackground": "#1a3a2e",
    "titleBar.activeForeground": "#e8f5e9",
    "titleBar.inactiveBackground": "#0f1e19",
    "titleBar.inactiveForeground": "#689f73",
    "titleBar.border": "#4caf50",
    "// Activity Bar (left sidebar icons)": "",
    "activityBar.background": "#1a3a2e",
    "activityBar.foreground": "#4caf50",
    "activityBar.inactiveForeground": "#689f73",
    "activityBar.border": "#2d5a47",
    "activityBar.activeBorder": "#4caf50",
    "activityBarBadge.background": "#1976d2",
    "activityBarBadge.foreground": "#ffffff",
    "// Status Bar (bottom bar)": "",
    "statusBar.background": "#1a3a2e",
    "statusBar.foreground": "#e8f5e9",
    "statusBar.noFolderBackground": "#0f1e19",
    "statusBar.debuggingBackground": "#1565c0",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBar.border": "#4caf50",
    "// Side Bar (file explorer)": "",
    "sideBar.background": "#0f1e19",
    "sideBar.foreground": "#e8f5e9",
    "sideBar.border": "#2d5a47",
    "sideBarTitle.foreground": "#4caf50",
    "sideBarSectionHeader.background": "#1a3a2e",
    "sideBarSectionHeader.foreground": "#4caf50",
    "// Editor": "",
    "editor.background": "#0d1b14",
    "editor.foreground": "#e8f5e9",
    "editor.lineHighlightBackground": "#1a3a2e33",
    "editor.selectionBackground": "#4caf5044",
    "editor.inactiveSelectionBackground": "#4caf5022",
    "editorLineNumber.foreground": "#4caf5088",
    "editorLineNumber.activeForeground": "#4caf50",
    "editorCursor.foreground": "#4caf50",
    "editorWhitespace.foreground": "#4caf5033",
    "editorIndentGuide.background": "#2d5a4733",
    "editorIndentGuide.activeBackground": "#4caf5066",
    "// Editor Groups & Tabs": "",
    "editorGroupHeader.tabsBackground": "#0f1e19",
    "editorGroupHeader.border": "#2d5a47",
    "tab.activeBackground": "#1a3a2e",
    "tab.activeForeground": "#e8f5e9",
    "tab.activeBorder": "#4caf50",
    "tab.inactiveBackground": "#0f1e19",
    "tab.inactiveForeground": "#689f73",
    "tab.border": "#2d5a47",
    "// Panel (terminal, output, etc.)": "",
    "panel.background": "#0f1e19",
    "panel.border": "#4caf50",
    "panelTitle.activeBorder": "#4caf50",
    "panelTitle.activeForeground": "#4caf50",
    "panelTitle.inactiveForeground": "#689f73",
    "// Terminal": "",
    "terminal.background": "#0d1b14",
    "terminal.foreground": "#e8f5e9",
    "terminal.ansiBlack": "#0d1b14",
    "terminal.ansiRed": "#e57373",
    "terminal.ansiGreen": "#4caf50",
    "terminal.ansiYellow": "#ffd54f",
    "terminal.ansiBlue": "#1976d2",
    "terminal.ansiMagenta": "#ba68c8",
    "terminal.ansiCyan": "#4dd0e1",
    "terminal.ansiWhite": "#e8f5e9",
    "terminal.ansiBrightBlack": "#689f73",
    "terminal.ansiBrightRed": "#ef5350",
    "terminal.ansiBrightGreen": "#66bb6a",
    "terminal.ansiBrightYellow": "#ffee58",
    "terminal.ansiBrightBlue": "#42a5f5",
    "terminal.ansiBrightMagenta": "#ab47bc",
    "terminal.ansiBrightCyan": "#26c6da",
    "terminal.ansiBrightWhite": "#ffffff",
    "// Git Decorations": "",
    "gitDecoration.modifiedResourceForeground": "#42a5f5",
    "gitDecoration.deletedResourceForeground": "#e57373",
    "gitDecoration.untrackedResourceForeground": "#4caf50",
    "gitDecoration.ignoredResourceForeground": "#689f73",
    "gitDecoration.conflictingResourceForeground": "#ffd54f",
    "// Breadcrumbs": "",
    "breadcrumb.background": "#0f1e19",
    "breadcrumb.foreground": "#689f73",
    "breadcrumb.focusForeground": "#4caf50",
    "breadcrumb.activeSelectionForeground": "#4caf50"
  },
  "// ========== EDITOR SETTINGS ==========": "",
  "editor.fontFamily": "'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.5,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 80,
  "editor.rulers": [80, 100],
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "// ========== FILES ==========": "",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/.venv": true,
    "**/venv": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "// ========== PYTHON SETTINGS ==========": "",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.formatting.provider": "none",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.linting.flake8Enabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.tabSize": 4
  },
  "// ========== JAVASCRIPT/TYPESCRIPT SETTINGS ==========": "",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on"
  },
  "// ========== PRETTIER SETTINGS ==========": "",
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.trailingComma": "es5",
  "prettier.tabWidth": 2,
  "// ========== TERMINAL SETTINGS ==========": "",
  "terminal.integrated.fontFamily": "'Cascadia Code', 'Fira Code', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "// ========== GIT SETTINGS ==========": "",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.decorations.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "// ========== SEARCH SETTINGS ==========": "",
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.next": true
  },
  "// ========== EMMET ==========": "",
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "// ========== ESLINT ==========": "",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "// ========== DOCKER ==========": "",
  "docker.containers.description": ["ContainerName", "Status"],
  "docker.containers.sortBy": "CreatedTime",
  "// ========== TAILWIND CSS ==========": "",
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "// ========== MUSEUM SPECIFIC ==========": "",
  "// Consciousness-serving code deserves consciousness-serving tools": "",
  "editor.tokenColorCustomizations": {
    "comments": "#689f73",
    "strings": "#4dd0e1",
    "keywords": "#42a5f5",
    "functions": "#4caf50",
    "variables": "#e8f5e9"
  },
  "// ========== AI/ML DEVELOPMENT ==========": "",
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "// ========== COPILOT ==========": "",
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true
  },
  "containers.containers.description": ["ContainerName", "Status"],
  "containers.containers.sortBy": "CreatedTime"
}
