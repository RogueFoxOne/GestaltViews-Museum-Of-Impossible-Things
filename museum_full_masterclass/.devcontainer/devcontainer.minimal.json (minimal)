{
  "name": "Museum of Impossible Things (Minimal)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": "20",
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [
    3000,
    8000
  ],
  "postCreateCommand": "pip install fastapi uvicorn motor python-dotenv && echo '\u2705 Minimal setup complete'",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#1a3a2e",
          "activityBar.background": "#1a3a2e",
          "statusBar.background": "#1a3a2e"
        }
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
